{
  "name": "@rutan/deployment-zip",
  "type": "module",
  "version": "0.7.1",
  "description": "A CLI tool to create a deployment zip file.",
  "author": "ru_shalm <ru_shalm@hazimu.com>",
  "license": "MIT",
  "homepage": "https://github.com/rutan/deployment-zip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rutan/deployment-zip.git"
  },
  "bin": {
    "deployment-zip": "bin/deployment-zip"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "files": ["bin", "lib", "src"],
  "scripts": {
    "start": "node ./bin/deployment-zip",
    "dev": "jiti ./src/cli.ts",
    "build": "run-s clean build:*",
    "build:tsc": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "run-s lint:*",
    "lint:biome": "biome check ./",
    "lint:tsc": "tsc --noEmit",
    "format": "biome format ./ --write",
    "clean": "rimraf ./lib"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/credential-provider-node": "^3.972.39",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "archiver": "^7.0.1",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "ignore": "^7.0.5",
    "jiti": "^2.7.0",
    "mime": "^4.1.0",
    "node-html-parser": "^7.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.6.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.7.0",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.28.0"
}

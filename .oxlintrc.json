{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["lib/**", "tmp/**", "example/sample/**/*"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  }
}
